{
  "name": "murya-collecte",
  "private": true,
  "type": "module",
  "description": "Plateforme de collecte d'enregistrements vocaux Murya (zarma d'abord)",
  "workspaces": [
    "packages/*",
    "apps/*",
    "api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:voix": "npm run dev -w @murya/voix",
    "dev:equipe": "npm run dev -w @murya/equipe",
    "dev:api": "npm run dev -w @murya/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "budget": "node scripts/budget.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.57.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
