# En-têtes de sécurité appliqués par Cloudflare (Worker « fichiers statiques ») à toutes les pages.
# connect-src autorise https: pour l'instant (API et R2 sur des domaines *.workers.dev /
# *.r2.cloudflarestorage.com) ; à restreindre quand le nom de domaine sera acheté.
# media-src https: : vidéo du tutoriel et audios du consentement, hébergés à part.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: microphone=(self), camera=(), geolocation=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https:; media-src 'self' blob: https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'

# Le service worker doit toujours être relu, sinon les mises à jour n'arrivent pas.
/sw.js
  Cache-Control: no-cache
