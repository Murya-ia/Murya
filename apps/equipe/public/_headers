# En-têtes de sécurité appliqués par Cloudflare (Worker « fichiers statiques »).
# connect-src : Supabase (*.supabase.co) et l'API ; à restreindre quand le domaine sera acheté.
/*
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex
  Permissions-Policy: microphone=(), camera=(), geolocation=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https: wss://*.supabase.co; media-src 'self' blob: https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'
